# Настройки запуска. На сервере скопируйте этот файл в .env рядом с docker-compose.yml и замените все значения.
# Сам файл .env на GitHub не попадает. Настоящие ключи и пароли пишите только туда.

# Пароль базы данных: длинная случайная строка
POSTGRES_PASSWORD="your_long_random_database_password"

# Секрет для входа на сайт: длинная случайная строка. Если его сменить, всем придётся войти заново.
JWT_SECRET="your_long_random_jwt_secret"

# Адрес сайта
FRONTEND_URL="https://sadovodps24.ru"

# Telegram: ключ бота из BotFather
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
# Заполните, только если с этого сервера Telegram не открывается напрямую. Адрес промежуточного сервера за границей: https://имя:пароль@адрес
TELEGRAM_PROXY_URL=""
# polling: сайт сам забирает события бота, входящие сообщения от Telegram серверу не нужны. Включайте только на одном сервере.
TELEGRAM_UPDATES="polling"
# Нужно только при TELEGRAM_UPDATES="webhook": длинная случайная строка, её же нужно передать боту в setWebhook как secret_token.
TELEGRAM_WEBHOOK_SECRET=""

# ВКонтакте: номер приложения для входа и ключ шлюза для публикации
VK_APP_ID="54490006"
KOMOD_TOKEN="your_komod_token"

# Ключ ИИ для кнопки «Улучшить текст»
KIE_API_KEY="your_kie_api_key"
